{
  "manifest_version": 3,
  "name": "Gallerify — Page Media Gallery",
  "version": "1.0.0",
  "description": "Browse images and videos from any page in a clean gallery.",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/gallerify16.png",
    "32": "icons/gallerify32.png",
    "48": "icons/gallerify48.png",
    "128": "icons/gallerify128.png"
  },
  "action": {
    "default_title": "Open page media gallery",
    "default_icon": {
      "16": "icons/gallerify16.png",
      "32": "icons/gallerify32.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
